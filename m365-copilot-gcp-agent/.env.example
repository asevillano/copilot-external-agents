# Copy to .env IN THIS FOLDER. Never use the repository's other environments.
# Anonymous mode is accepted only on loopback, for Agents Playground.
LOCAL_DEVELOPMENT=false
HOST=127.0.0.1
PORT=3978

# Entra application used by Azure Bot Service (single tenant).
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTSECRET=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=

# Corporate Copilot tenant, independent of Azure subscription/bot identity tenant.
M365_TENANT_ID=
# Azure Bot OAuth connection: Entra v2, corporate tenant authority, delegated User.Read.
ENTRA_OAUTH_CONNECTION_NAME=
# Explicit pilot allowlist: comma-separated Entra object IDs IN THE CORPORATE TENANT.
# UPNs, guests' object IDs in the hosting tenant and wildcards are not accepted.
ENTRA_ALLOWED_USER_IDS=

# REQUIRED: verified resource of the DEPLOYED Renewal Risk Analyst, not runtime_test_agent.
GCP_AGENT_RESOURCE=
# Format: projects/PROJECT/locations/REGION/reasoningEngines/ENGINE_ID
# Use ADC locally; in production use an attached identity / workload identity.
# GOOGLE_APPLICATION_CREDENTIALS=C:\secure\external-account-config.json

# Azure Container Apps: keyless technical identity, not delegation of the M365 user.
# Google WIF provider restricted to the hosting tenant and the managed identity object ID.
# Local development keeps using ADC when these settings are empty.
GCP_WORKLOAD_IDENTITY_AUDIENCE=
# //iam.googleapis.com/projects/PROJECT_NUMBER/locations/global/workloadIdentityPools/POOL/providers/PROVIDER
GCP_AZURE_TOKEN_RESOURCE=
# api://AzureADTokenExchange (managed identity token exchange audience) or api://CLIENT_ID.
# IDENTITY_ENDPOINT and IDENTITY_HEADER are supplied by Azure, never copied here.
# AZURE_CLIENT_ID= user-assigned managed identity client ID, when applicable.

# No local state: conversation history and session lookup live in Agent Engine.
AGENT_TIMEOUT_SECONDS=180

# --- Deployment settings, read by scripts/*.py (GCP_AGENT_RESOURCE above is shared) ---
# Azure subscription and Entra tenant (GUIDs) that host the bridge, the bot and the M365 users.
AZURE_SUBSCRIPTION_ID=
ENTRA_TENANT_ID=
# Client ID of the bot's Entra app registration (phase 2) and Azure Bot resource name (phase 3).
BOT_APP_ID=
# Optional; defaults to renewal-risk-m365-<first 8 chars of BOT_APP_ID>.
BOT_NAME=
BOT_OAUTH_CONNECTION_NAME=entra-user-read
# Entra object IDs of the users allowed to talk to the agent (comma-separated).
PILOT_ALLOWED_USER_IDS=
# Globally unique ACR name for infra/aca-foundation.bicep.
ACR_NAME=
# GCP project ID and number, workload identity provider, and the agent's data and tools.
GCP_PROJECT_ID=
GCP_PROJECT_NUMBER=
GCP_WIF_PROVIDER_ID=azure
# Bucket holding contracts_txt/ (without gs://).
GCP_DOCS_BUCKET=
# https://<host>/mcp of the CRM and ticketing MCP servers used by the GCP agent.
SALESFORCE_MCP_URL=
SERVICENOW_MCP_URL=
