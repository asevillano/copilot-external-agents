# Weather bridge. Copy to .env in this folder. Never reuse other versions' .env files.
LOCAL_DEVELOPMENT=true
HOST=127.0.0.1
PORT=3978
MCP_SERVER_URL=http://127.0.0.1:8766/mcp

# Azure (set by infra/bridge.bicep): bot credentials, M365_TENANT_ID,
# ENTRA_OAUTH_CONNECTION_NAME, ENTRA_ALLOWED_USER_IDS, MCP_SERVER_URL (public https of the
# weather agent's ACA), MCP_TOKEN_RESOURCE (api://<weather-mcp-api-app-id>), AZURE_CLIENT_ID.
AGENT_TIMEOUT_SECONDS=120