# Deployment settings for scripts/*.py. Copy to .env IN THIS FOLDER (git-ignored).
# Runtime settings for local runs live in weather-agent/.env and bridge/.env instead.

# Azure subscription and Entra tenant (GUIDs) that host the apps, the bot and the M365 users.
AZURE_SUBSCRIPTION_ID=
ENTRA_TENANT_ID=
# Optional: account suggested in the interactive Entra sign-in of deploy_weather_stack.py.
ENTRA_ADMIN_UPN=
# Entra object IDs of the users allowed to talk to the agent (comma-separated).
PILOT_ALLOWED_USER_IDS=
# Azure Bot: OAuth connection name; BOT_NAME is optional (default weather-m365-<app id>).
BOT_OAUTH_CONNECTION_NAME=entra-weather
BOT_NAME=
# Existing ACR and Microsoft Foundry (Azure OpenAI) account used by infra/foundation-weather.bicep.
ACR_NAME=
FOUNDRY_NAME=
