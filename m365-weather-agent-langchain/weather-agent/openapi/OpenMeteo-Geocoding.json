{
  "swagger": "2.0",
  "info": {
    "title": "OpenMeteo Geocoding",
    "version": "1.0"
  },
  "host": "geocoding-api.open-meteo.com",
  "basePath": "/",
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/search": {
      "get": {
        "summary": "Search location",
        "description": "Search city and return coordinates",
        "operationId": "searchLocation",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": true,
            "type": "string",
            "description": "City name"
          },
          {
            "name": "count",
            "in": "query",
            "required": false,
            "type": "integer",
            "default": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    }
  }
}