# LangChain weather agent + MCP. Copy to .env in this folder for local runs.
# Local: anonymous MCP on loopback; the model is called with your az login (Entra, no keys).
MCP_LOCAL_DEVELOPMENT=true
HOST=127.0.0.1
PORT=8766
AZURE_OPENAI_ENDPOINT=https://<foundry-name>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-5.6-luna
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Azure (set by infra/weather-agent.bicep): ENTRA_TENANT_ID, MCP_AUDIENCES,
# MCP_ALLOWED_CLIENT_IDS, MCP_RESOURCE_URL, MCP_ALLOWED_HOSTS, AZURE_CLIENT_ID.
