# -mcp bridge. Copy to .env in this folder. Never reuse the other version's .env.
# Local: Agents Playground on loopback, MCP adapter running locally without auth.
LOCAL_DEVELOPMENT=true
HOST=127.0.0.1
PORT=3978
MCP_SERVER_URL=http://127.0.0.1:8765/mcp

# Azure (set by infra/bridge.bicep): bot credentials, M365_TENANT_ID,
# ENTRA_OAUTH_CONNECTION_NAME, ENTRA_ALLOWED_USER_IDS, MCP_SERVER_URL (https internal),
# MCP_TOKEN_RESOURCE (api://<mcp-api-app-id>), AZURE_CLIENT_ID. No Google Cloud settings.
AGENT_TIMEOUT_SECONDS=300
