# Deployment settings for scripts/*.py. Copy to .env IN THIS FOLDER (git-ignored).
# Runtime settings for local runs live in mcp-server/.env and bridge/.env instead.

# Azure subscription and Entra tenant (GUIDs) that host the apps, the bot and the M365 users.
AZURE_SUBSCRIPTION_ID=
ENTRA_TENANT_ID=
# Optional: account suggested in the interactive Entra sign-in of deploy_mcp_stack.py.
ENTRA_ADMIN_UPN=
# Entra object IDs of the users allowed to talk to the agent (comma-separated).
PILOT_ALLOWED_USER_IDS=
# Azure Bot: OAuth connection name; BOT_NAME is optional (default renewal-risk-m365-mcp-<app id>).
BOT_OAUTH_CONNECTION_NAME=entra-mcp
BOT_NAME=
# Existing ACR (shared with the direct version) used by infra/foundation-mcp.bicep.
ACR_NAME=

# GCP: deployed Renewal Risk Analyst and workload identity federation.
GCP_PROJECT_NUMBER=
# projects/<project-number>/locations/us-central1/reasoningEngines/<engine-id>
GCP_AGENT_RESOURCE=
GCP_WIF_PROVIDER_ID=azure-mcp

# https://<host>/mcp of the GCP agent's own tool servers (warmup_agent_tools.py).
SALESFORCE_MCP_URL=
SERVICENOW_MCP_URL=
