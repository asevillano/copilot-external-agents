# MCP adapter for the GCP Renewal Risk Analyst. Copy to .env in this folder for local runs.
# Local: anonymous MCP on loopback only, Agent Engine through your own ADC.
MCP_LOCAL_DEVELOPMENT=true
HOST=127.0.0.1
PORT=8765
GCP_AGENT_RESOURCE=projects/<project-number>/locations/us-central1/reasoningEngines/<engine-id>

# Azure (set by infra/mcp-server.bicep, never copied by hand):
# ENTRA_TENANT_ID, MCP_AUDIENCES (api://<mcp-api-app-id>,<mcp-api-app-id>),
# MCP_ALLOWED_CLIENT_IDS (client IDs of identities allowed to call), MCP_RESOURCE_URL,
# MCP_ALLOWED_HOSTS, AZURE_CLIENT_ID, GCP_WORKLOAD_IDENTITY_AUDIENCE, GCP_AZURE_TOKEN_RESOURCE
